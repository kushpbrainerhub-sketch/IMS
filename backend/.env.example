DATABASE_URL=postgresql+psycopg2://ims_user:your_password@localhost:5432/ims
SECRET_KEY=change_me
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Used to build links in verification/password-reset emails
FRONTEND_URL=http://localhost:5173

# SMTP settings for sending verification/password-reset emails.
# Leave SMTP_HOST empty to just log email content to the console (dev default).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
